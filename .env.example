SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GROQ_API_KEY="YOUR_GROQ_API_KEY"
SUPABASE_TABLE_USERS="users"

# Production: keep false. Prefer shipping certs/cacert.pem (auto-detected).
# Optional override: CURL_CA_BUNDLE="C:/path/to/cacert.pem"
SUPABASE_DEV_SKIP_SSL_VERIFY="false"
SMTP_DEV_SKIP_SSL_VERIFY="false"
# CURL_CA_BUNDLE=""

# REQUIRED — long random string. Must match Flutter lib/config/env.dart mobilePushApiKey.
# If empty, all mobile APIs return 503 (fail closed).
MOBILE_PUSH_API_KEY="YOUR_LONG_RANDOM_SHARED_KEY"

# Web session cookie Secure: auto | true | false (auto = on when request is HTTPS)
SESSION_COOKIE_SECURE="auto"

EMAIL_SENDER_ADDRESS="ccspulseconnect@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_ENCRYPTION="tls"
SMTP_USERNAME="ccspulseconnect@gmail.com"
SMTP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"
SMTP_FROM_NAME="CCS PulseConnect"
